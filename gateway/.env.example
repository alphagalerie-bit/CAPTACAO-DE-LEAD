# ============================================================
# Gateway do Conectado - variaveis de ambiente
# Copie para .env localmente, ou cole no painel do Railway/Render.
# NUNCA comite este arquivo preenchido.
# ============================================================

# Senha compartilhada entre o admin e o gateway.
# Gere uma aleatoria e cole tambem no campo gatewayToken do CONFIG do admin.
CONECTADO_TOKEN=troque-por-uma-senha-aleatoria-longa

# Chave da API da Anthropic - e o que faz a IA responder.
# Pegue em console.anthropic.com
ANTHROPIC_API_KEY=

# Mercado Pago - Access Token de PRODUCAO.
# Gere um NOVO em Suas integracoes > Credenciais de producao > Renovar.
# O que voce colou no chat esta comprometido, nao reutilize.
MP_ACCESS_TOKEN=

# Dominio do admin, para o CORS. Use a URL exata.
ORIGEM_PERMITIDA=https://admin.alphagalerie.com

# URL publica deste gateway (Railway/Render te da uma).
# Usada pelo webhook de pagamento do Mercado Pago.
URL_GATEWAY=

# Site que recebe o cliente depois de pagar
URL_SITE=https://conectado.alphagalerie.com

# Seu nome, usado quando a IA escala a conversa
MEU_NOME=Leo

# Minutos que a IA fica calada depois que voce responde manualmente
PAUSA_HUMANA_MIN=30

# Opcional: endpoint que recebe os eventos de conversa e pagamento
WEBHOOK_CRM=
